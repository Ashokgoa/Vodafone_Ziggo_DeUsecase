# Copy to .env and fill in real values locally. Never commit .env.
# Placeholders only — further settings (LLM provider, vector store, etc.)
# will be added once those technologies are selected.

APP_ENV=local
LOG_LEVEL=INFO
ZIGGO_URL=https://www.ziggo.nl/internet
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
VECTOR_STORE_DIR=data/vectorstore
RETRIEVAL_TOP_K=3
RETRIEVAL_MAX_DISTANCE=0.65
FALLBACK_MESSAGE=I couldn't find a confident answer to that question based on the information on this page. Please contact a Ziggo advisor for further help.

# Required to actually call the LLM (see README for how to get one).
# Never commit a real key.
ANTHROPIC_API_KEY=your-api-key-here
LLM_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=500
